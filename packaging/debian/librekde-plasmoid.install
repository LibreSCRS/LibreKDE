usr/share/plasma/plasmoids/org.librescrs.smartcard/
usr/lib/*/qt6/qml/org/librescrs/smartcard/
# The applet's message catalogue is named plasma_applet_* rather than after the
# package, so a catch-all would have been the only way to miss it -- which is
# why there is no catch-all anywhere in these lists. The applet's C++ code is
# the QML plugin above; it has no shared library of its own.
usr/share/locale/*/LC_MESSAGES/plasma_applet_org.librescrs.smartcard.mo
