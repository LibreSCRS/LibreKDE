usr/share/plasma/plasmoids/org.librescrs.smartcard/
usr/lib/*/qt6/qml/org/librescrs/smartcard/
# The applet's own C++ library and its message catalogue. Both are named
# plasma_applet_* or liblibrekde-plasmoid rather than following the package
# name, so a catch-all would have been the only way to miss them -- which is why
# there is no catch-all anywhere in these lists.
usr/lib/*/liblibrekde-plasmoid.so
usr/share/locale/*/LC_MESSAGES/plasma_applet_org.librescrs.smartcard.mo
