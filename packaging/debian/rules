#!/usr/bin/make -f

# Link-time optimisation off, as in the rpm and Arch recipes. Debian leaves it
# off by default, but Ubuntu turns it on, so the deb recipe has to say so too.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto
export DEB_CPPFLAGS_MAINT_APPEND = -DNDEBUG

%:
	dh $@ --buildsystem=cmake+ninja --builddirectory=build

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=OFF

override_dh_auto_test:

# Plasmoid, KIO worker and Purpose plugin are loaded by the desktop, not linked.
override_dh_makeshlibs:
	dh_makeshlibs -X/plasma/ -X/kf6/ -X/qt6/

override_dh_missing:
	dh_missing --fail-missing
