# Maintainer: hirashix0 <hirashix0@proton.me>
#
# LibreKDE — KDE Plasma 6 integration for the LibreSCRS stack: the smart-card
# plasmoid, the credential-management window, the Purpose "Sign" share plugin,
# and the card:/ KIO worker.
#
# LibreKDE is a THIN CLIENT of the LibreSCRS agent over D-Bus — it links NO
# LibreMiddleware target (card I/O + secret entry live in the agent). So it
# depends on `librescrs-agent` (the agent package built from pkgbase
# `librelinux`), NOT on `librescrs-middleware`.
#
# It also LINKS `librescrs-agent-client-qt`, the Qt client library
# (LibreAgent::ClientQt). That package has its OWN pkgbase of the same name,
# built from the LibreAgent repository — it is not one of the packages
# `librelinux` produces. It appears in both depends (the shared library at
# runtime) and makedepends (the CONFIG package find_package() resolves at
# configure time). Its own depends are Qt6 and libc only, so it pulls no part
# of the middleware stack in with it.
#
# Dependency chain — two roots, not one:
#     librescrs-middleware  <=  librelinux  <=  librekde
#     librescrs-agent-client-qt  <=  librekde
#
# Versioning: this component no longer carries its own 0.x SemVer. It is
# released in lockstep with the rest of the stack, and pkgver is the first
# line of the repository's VERSION file.

pkgname=librekde
pkgver=5.0.0
pkgrel=1
pkgdesc="KDE Plasma 6 integration for LibreSCRS: smart-card plasmoid, credential-management window, Purpose Sign plugin, and card:/ KIO worker"
arch=('x86_64')
url="https://github.com/LibreSCRS/LibreKDE"
license=('LGPL-2.1-or-later')
# The agent is a hard dependency here and a Recommends in the deb and RPM
# recipes, for the same outcome: apt and dnf install a recommended package by
# default, while pacman has no weak dependency it installs on its own — an
# optdepends is only printed. A plain `pacman -S librekde` therefore gets the
# agent the same way `apt install librekde` does.
depends=(
    'librescrs-agent'   # the D-Bus agent this client talks to
    'librescrs-agent-client-qt' # LibreAgent::ClientQt (find_package(LibreAgent CONFIG))
    'plasma-workspace'  # Plasma 6 shell (plasmoid host)
    'libplasma'         # find_package(Plasma 6.0)
    'qt6-base'          # Core/Gui/DBus/Widgets
    'qt6-declarative'   # Qml (plasmoid) incl. QtQuick.Dialogs (Save photo…);
                        #   also Quick/QuickControls2/QuickTemplates2 (credentials window)
    'ki18n'
    'kcoreaddons'
    'knotifications'
    'kconfig'
    'kio'               # card:/ KIO worker
    'purpose'           # Purpose "Sign" plugin
    'kirigami'          # credential-management window UI
    'kdbusaddons'       # credential window single-instance (KDBusService)
    'qqc2-desktop-style' # org.kde.desktop QtQuick Controls style for the window
)
makedepends=(
    'cmake'
    'ninja'
    'git'                   # GitVersion.cmake
    'extra-cmake-modules'   # ECM (KDEInstallDirs/KDECMakeSettings/...)
    'qt6-tools'             # lrelease for ki18n .po -> .qm (ECMPoQmTools)
    'librescrs-agent-client-qt' # find_package(LibreAgent 5.0 CONFIG COMPONENTS ClientQt)
                                #   at configure time (cmake/FindOrUseLibreAgent.cmake)
)
options=('!lto')   # LTO off, as the RPM spec does; not measured to be required
# The signed tag itself, not a tarball: makepkg checks the tag's signature
# against validpgpkeys before it builds anything, so the recipe needs no
# checksum that could only be written after the release exists. The key is the
# release key's primary fingerprint, the one KEYS carries (the tag is signed by
# a subkey; makepkg matches the primary). check-recipe (LibreSCRS/ci) holds
# all three -- this repository, the tag, the key -- to the tree.
source=(
    "git+https://github.com/LibreSCRS/LibreKDE.git#tag=$pkgver?signed"
)
validpgpkeys=('6B05889AC9A6A7188DF639B06F27A989C2031D16')  # LibreSCRS release key
sha256sums=('SKIP')  # a git source has no archive to checksum; the signature is the check

build() {
    cd "$srcdir/LibreKDE"
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF
    cmake --build build -j4
}

package() {
    cd "$srcdir/LibreKDE"
    DESTDIR="$pkgdir" cmake --install build
    # cmake --install lays down the plasmoid package, the credential-management
    # window (bin/librescrs-credentials-kde + its NoDisplay .desktop under
    # KDE_INSTALL_APPDIR), the Purpose plugin + its metainfo, the card:/ KIO
    # worker, the smartcard AppStream metainfo, and the ki18n gettext catalogues
    # — all under KDE_INSTALL_* (/usr/...). ki18n_install(po) now fires: the
    # po/ dir ships sr + sr@latin catalogues for the `librekde` and
    # `plasma_applet_org.librescrs.smartcard` domains
    # (share/locale/<lang>/LC_MESSAGES/<domain>.mo).
    # The credential window is a NoDisplay helper launched from the plasmoid, so
    # it gets no separate AppStream component (it is not an app-store entry).
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # The agent client library is released in lockstep with its consumers and
    # carries no ABI gate: depend on EXACTLY the build this was compiled against.
    local agentclient
    agentclient=$(pacman -Q librescrs-agent-client-qt | cut -d' ' -f2)
    depends=("${depends[@]/#librescrs-agent-client-qt/librescrs-agent-client-qt=$agentclient}")
}
