# --- PreAuthState.qml -----------------------------------------------------
#: components/plasmoid/package/contents/ui/PreAuthState.qml:22
msgctxt "@info plasmoid pre-read auth required"
msgid "This card must be unlocked before it can be read"
msgstr "Ova kartica mora da se otključa pre čitanja"

#: components/plasmoid/package/contents/ui/PreAuthState.qml:27
msgctxt "@info plasmoid pre-read auth explanation"
msgid ""
"When you read the card, the LibreSCRS service opens a secure prompt to enter "
"the card's CAN or scan its MRZ."
msgstr ""
"Kada pročitate karticu, LibreSCRS servis otvara bezbedni upit za unos CAN-a "
"kartice ili skeniranje njenog MRZ-a."

#: components/plasmoid/package/contents/ui/PreAuthState.qml:38
msgctxt "@action:button start reading a pre-auth card"
msgid "Read Card…"
msgstr "Pročitaj karticu…"

#: components/plasmoid/package/contents/ui/PreAuthState.qml:47
msgctxt "@info:whatsthis read pre-auth card button"
msgid ""
"Reads this card. A secure prompt from the LibreSCRS service will ask for the "
"card's CAN or MRZ."
msgstr ""
"Čita ovu karticu. Bezbedni upit LibreSCRS servisa će zatražiti CAN ili MRZ "
"kartice."

#: components/plasmoid/package/contents/ui/RefreshButton.qml:33
