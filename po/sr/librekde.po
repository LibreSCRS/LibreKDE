#: shared/agentclient/ErrorText.cpp:132
#, kde-format
msgid "This card is not supported."
msgstr "Ова картица није подржана."

#: shared/agentclient/ErrorText.cpp:134
#, kde-format
msgid "Authentication with the card failed."
msgstr "Аутентификација са картицом није успела."

#: shared/agentclient/ErrorText.cpp:136
#, kde-format
msgid "The secure entry prompt could not be shown."
