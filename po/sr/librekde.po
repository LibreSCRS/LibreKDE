# --- shared/agentclient/ErrorText.cpp (transport failures, ki18ndc) ---------
# These seven cover a failure that never got an answer over the wire, so it
# carries no error code of its own — one per transport outcome, plus a floor
# for a failure that classified on neither axis and said nothing.
#
# The Serbian below has had its native review and is settled copy, as is the
# English. Two English strings had open wording questions and were decided;
# the Serbian follows those decisions.
#   * the access-denied string no longer sends the reader to a system
#     administrator, which misdirected for the member of that bucket that means
#     nobody is logged in rather than a permission being withheld; it now
#     states the fact and stops;
#   * the refusal string now says "before any work on it started", because
#     "before it could be carried out" faintly implied the request might have
#     gone through later, which is untrue when the two sides simply speak
#     different versions.
#: shared/agentclient/ErrorText.cpp:23
#, kde-format
msgctxt "@info:status the operation failed without reporting any reason"
msgid "The operation did not finish, and no reason was reported."
msgstr "Операција није завршена, а разлог није пријављен."

#: shared/agentclient/ErrorText.cpp:54
#, kde-format
msgctxt "@info:status the smart-card service could not be reached at all"
msgid ""
"Could not reach the smart-card service. Check that it is installed and "
"running."
msgstr ""
"Сервис за паметне картице није доступан. Проверите да ли је инсталиран и "
"покренут."

#: shared/agentclient/ErrorText.cpp:58
#, kde-format
msgctxt "@info:status the smart-card service did not answer in time"
msgid "The smart-card service did not answer in time. Try again."
msgstr "Сервис за паметне картице није одговорио на време. Покушајте поново."

#: shared/agentclient/ErrorText.cpp:67
#, kde-format
msgctxt ""
"@info:status the system denied this application access to the smart-card "
"service"
msgid "Permission to use the smart-card service was denied."
msgstr "Приступ сервису за паметне картице је одбијен."

#: shared/agentclient/ErrorText.cpp:83
#, kde-format
msgctxt ""
"@info:status the request was rejected before any work on it started; do not "
"name who rejected it, it may be this application, the smart-card service, or "
"the message bus"
msgid "This request was refused before any work on it started."
msgstr "Овај захтев је одбијен пре него што је ишта урађено."

#: shared/agentclient/ErrorText.cpp:87
#, kde-format
msgctxt ""
"@info:status the connection to the smart-card service broke during the "
"request"
msgid "The connection to the smart-card service was lost. Try again."
msgstr "Веза са сервисом за паметне картице је прекинута. Покушајте поново."

#: shared/agentclient/ErrorText.cpp:91
#, kde-format
msgctxt "@info:status the smart-card service's reply could not be understood"
msgid ""
"The smart-card service replied in a way this application does not "
"understand. The two may be different versions."
msgstr ""
"Сервис за паметне картице је одговорио на начин који овај програм не разуме. "
"Могуће је да су различитих верзија."

#: shared/agentclient/ErrorText.cpp:124
#, kde-format
msgid "The PIN or access code entered was incorrect."
msgstr "Унети ПИН или приступни код није исправан."

#: shared/agentclient/ErrorText.cpp:126
#, kde-format
msgid "The card credential is blocked. Unblock it before retrying."
msgstr "Акредитив картице је блокиран. Деблокирајте га пре поновног покушаја."

#: shared/agentclient/ErrorText.cpp:128
#, kde-format
